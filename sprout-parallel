#!/usr/bin/env bash
set -euo pipefail

# ─── Configuration ────────────────────────────────────────────────────────────

SPROUT_PROJECTS_ROOT="${SPROUT_PROJECTS_ROOT:-/Users/mehdi/projects}"
SCRIPT_NAME="$(basename "$0")"

# ─── Helpers ──────────────────────────────────────────────────────────────────

# die: print error to stderr and exit 1 (user error)
die() {
  echo "Error: $*" >&2
  exit 1
}

# die2: print error to stderr and exit 2 (git/internal failure)
die2() {
  echo "Error: $*" >&2
  exit 2
}

# safe_name: convert a branch name to a filesystem-safe folder name
#   feature/my-thing  →  feature-my-thing
safe_name() {
  local name="${1//\//-}"
  name="${name#-}"
  name="${name%-}"
  echo "$name"
}

# db_safe_name: convert a folder name to a MySQL-safe identifier
#   feature-my-thing  →  feature_my_thing
db_safe_name() {
  echo "${1//[^a-zA-Z0-9]/_}"
}

# parse_env_var: read a variable value from a .env file
#   $1: variable name (e.g. DB_DATABASE)
#   $2: path to .env file
parse_env_var() {
  { grep "^${1}=" "$2" 2>/dev/null || true; } | head -1 | cut -d= -f2-
}

# parse_env_value: like parse_env_var, but strips surrounding quotes and
# treats Laravel's literal "null" as empty
parse_env_value() {
  local value
  value="$(parse_env_var "$1" "$2")"
  value="${value#\"}"; value="${value%\"}"
  value="${value#\'}"; value="${value%\'}"
  [[ "$value" == "null" ]] && value=""
  echo "$value"
}

# set_env_var: replace KEY=... in a .env file, or append it if missing
#   $1: variable name  $2: value  $3: path to .env file
set_env_var() {
  local key="$1" value="$2" file="$3"
  if grep -q "^${key}=" "$file"; then
    sed -i '' "s|^${key}=.*|${key}=${value}|" "$file"
  else
    [[ -s "$file" && -n "$(tail -c 1 "$file")" ]] && echo >> "$file"
    echo "${key}=${value}" >> "$file"
  fi
}

# resolve_project: set REPLY_PROJECT_NAME and REPLY_PROJECT_PATH
resolve_project() {
  local project_name="${1:-}"

  if [[ -n "$project_name" ]]; then
    local project_path="$SPROUT_PROJECTS_ROOT/$project_name"
    [[ -d "$project_path" && ( -d "$project_path/.git" || -f "$project_path/.git" ) ]] \
      || die "Project '$project_name' not found under '$SPROUT_PROJECTS_ROOT'."
    REPLY_PROJECT_NAME="$project_name"
    REPLY_PROJECT_PATH="$project_path"
  else
    local git_root
    git_root="$(git rev-parse --show-toplevel 2>/dev/null)" \
      || die "Not inside a project directory. Use --project <name> to specify one."

    [[ "$git_root" == "$SPROUT_PROJECTS_ROOT"/* ]] \
      || die "Not inside a project directory. Use --project <name> to specify one."

    local rel="${git_root#${SPROUT_PROJECTS_ROOT}/}"
    local candidate="${rel%%/*}"

    local actual_name="$candidate"
    if [[ "$candidate" == *-worktrees ]]; then
      actual_name="${candidate%-worktrees}"
    fi

    local project_path="$SPROUT_PROJECTS_ROOT/$actual_name"
    [[ -d "$project_path" && ( -d "$project_path/.git" || -f "$project_path/.git" ) ]] \
      || die "Not inside a project directory. Use --project <name> to specify one."

    REPLY_PROJECT_NAME="$actual_name"
    REPLY_PROJECT_PATH="$project_path"
  fi
}

# ─── Setup Helpers ─────────────────────────────────────────────────────────────

copy_dir_from_project() {
  local src_dir="$1"
  local dest_dir="$2"
  local label="$3"

  [[ -d "$src_dir" ]] || return 0

  echo "  → Copying $label from main project"
  if command -v rsync > /dev/null 2>&1; then
    rsync -a --delete "$src_dir/" "$dest_dir/" \
      || echo "  Warning: rsync of $label exited with errors."
  else
    rm -rf "$dest_dir"
    cp -r "$src_dir" "$dest_dir" \
      || echo "  Warning: cp of $label exited with errors."
  fi
}

setup_db() {
  local dir="$1"
  local folder_name="$2"
  local env_file="$dir/.env"

  if ! command -v mysql > /dev/null 2>&1; then
    echo "  Warning: mysql not found — skipping database setup."
    return 0
  fi

  [[ -f "$env_file" ]] || return 0

  local src_db db_user db_pass db_host db_port
  src_db="$(parse_env_var DB_DATABASE "$env_file")"
  db_user="$(parse_env_var DB_USERNAME "$env_file")"
  db_pass="$(parse_env_var DB_PASSWORD "$env_file")"
  db_host="$(parse_env_var DB_HOST "$env_file")"
  db_port="$(parse_env_var DB_PORT "$env_file")"

  db_host="${db_host:-127.0.0.1}"
  db_port="${db_port:-3306}"

  if [[ -z "$src_db" || -z "$db_user" ]]; then
    echo "  Warning: Could not parse DB credentials from .env — skipping database setup."
    return 0
  fi

  local new_db="${src_db}_$(db_safe_name "$folder_name")"

  export MYSQL_PWD="$db_pass"
  local mysql_opts="-h${db_host} -P${db_port} -u${db_user}"

  echo "  → Creating database '$new_db' (clone of '$src_db')"
  if ! mysql $mysql_opts -e "CREATE DATABASE IF NOT EXISTS \`${new_db}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" 2>&1; then
    echo "  Warning: Failed to create database '$new_db' — skipping."
    unset MYSQL_PWD
    return 0
  fi

  echo "  → Cloning data from '$src_db' into '$new_db'"
  if command -v mysqldump > /dev/null 2>&1; then
    mysqldump $mysql_opts --single-transaction --set-gtid-purged=OFF "$src_db" \
      | mysql $mysql_opts "$new_db" \
      || echo "  Warning: Database clone may be incomplete."
  else
    echo "  Warning: mysqldump not found — database created but not populated."
  fi

  unset MYSQL_PWD

  # Point the worktree .env at the new database
  sed -i '' "s|^DB_DATABASE=.*|DB_DATABASE=${new_db}|" "$env_file"
  echo "  → Updated .env: DB_DATABASE=${new_db}"
}

drop_worktree_db() {
  local env_file="$1"

  [[ -f "$env_file" ]] || return 0
  command -v mysql > /dev/null 2>&1 || return 0

  local wt_db db_user db_pass db_host db_port
  wt_db="$(parse_env_var DB_DATABASE "$env_file")"
  db_user="$(parse_env_var DB_USERNAME "$env_file")"
  db_pass="$(parse_env_var DB_PASSWORD "$env_file")"
  db_host="$(parse_env_var DB_HOST "$env_file")"
  db_port="$(parse_env_var DB_PORT "$env_file")"

  db_host="${db_host:-127.0.0.1}"
  db_port="${db_port:-3306}"

  [[ -n "$wt_db" && -n "$db_user" ]] || return 0

  export MYSQL_PWD="$db_pass"
  echo "  → Dropping database '$wt_db'"
  mysql "-h${db_host}" "-P${db_port}" "-u${db_user}" \
    -e "DROP DATABASE IF EXISTS \`${wt_db}\`;" 2>&1 \
    || echo "  Warning: Failed to drop database '$wt_db'."
  unset MYSQL_PWD
}

# redis_cli: run redis-cli against the Redis server configured in a .env file
#   $1: path to .env file; remaining args are passed to redis-cli
redis_cli() {
  local env_file="$1"
  shift
  local host port pass
  host="$(parse_env_value REDIS_HOST "$env_file")"
  port="$(parse_env_value REDIS_PORT "$env_file")"
  pass="$(parse_env_value REDIS_PASSWORD "$env_file")"

  if [[ -n "$pass" ]]; then
    REDISCLI_AUTH="$pass" redis-cli -h "${host:-127.0.0.1}" -p "${port:-6379}" "$@"
  else
    redis-cli -h "${host:-127.0.0.1}" -p "${port:-6379}" "$@"
  fi
}

# allocate_redis_db: print the lowest Redis DB index not used by any project
# or worktree under $SPROUT_PROJECTS_ROOT. 0 and 1 are reserved for the main
# projects (Laravel's REDIS_DB / REDIS_CACHE_DB defaults). Returns 1 if none free.
#   $1: path to .env file (used to ask Redis how many databases it has)
allocate_redis_db() {
  local env_file="$1"
  local max=""

  if command -v redis-cli > /dev/null 2>&1; then
    max="$(redis_cli "$env_file" CONFIG GET databases 2>/dev/null | sed -n 2p || true)"
  fi
  [[ "$max" =~ ^[0-9]+$ ]] || max=16

  local used=" 0 1 " f key value
  for f in "$SPROUT_PROJECTS_ROOT"/*/.env "$SPROUT_PROJECTS_ROOT"/*-worktrees/*/.env; do
    [[ -f "$f" ]] || continue
    for key in REDIS_DB REDIS_CACHE_DB; do
      value="$(parse_env_value "$key" "$f")"
      [[ "$value" =~ ^[0-9]+$ ]] && used="$used$value "
    done
  done

  local n
  for ((n = 2; n < max; n++)); do
    if [[ "$used" != *" $n "* ]]; then
      echo "$n"
      return 0
    fi
  done
  return 1
}

setup_redis() {
  local dir="$1"
  local proj_name="$2"
  local folder_name="$3"
  local env_file="$dir/.env"

  [[ -f "$env_file" ]] || return 0
  grep -q "^REDIS_" "$env_file" || return 0

  local prefix
  prefix="$(db_safe_name "${proj_name}_${folder_name}" | tr '[:upper:]' '[:lower:]')_"

  set_env_var REDIS_PREFIX "$prefix" "$env_file"
  set_env_var CACHE_PREFIX "${prefix}cache_" "$env_file"
  set_env_var HORIZON_PREFIX "${prefix}horizon:" "$env_file"
  echo "  → Updated .env: REDIS_PREFIX=${prefix} (plus CACHE_PREFIX, HORIZON_PREFIX)"

  local redis_db
  if redis_db="$(allocate_redis_db "$env_file")"; then
    set_env_var REDIS_DB "$redis_db" "$env_file"
    set_env_var REDIS_CACHE_DB "$redis_db" "$env_file"
    echo "  → Updated .env: REDIS_DB=${redis_db}, REDIS_CACHE_DB=${redis_db}"
  else
    echo "  Warning: No free Redis database index — worktree shares the main DB (isolated by prefix only)."
  fi
}

clear_worktree_redis() {
  local env_file="$1"

  [[ -f "$env_file" ]] || return 0
  command -v redis-cli > /dev/null 2>&1 || return 0

  local prefix redis_db
  prefix="$(parse_env_value REDIS_PREFIX "$env_file")"
  redis_db="$(parse_env_value REDIS_DB "$env_file")"
  redis_db="${redis_db:-0}"

  # Only clear worktrees that sprout-parallel gave their own prefix
  [[ -n "$prefix" ]] || return 0

  local host port pass
  host="$(parse_env_value REDIS_HOST "$env_file")"
  port="$(parse_env_value REDIS_PORT "$env_file")"
  pass="$(parse_env_value REDIS_PASSWORD "$env_file")"
  local cli=(redis-cli -h "${host:-127.0.0.1}" -p "${port:-6379}" -n "$redis_db")

  [[ -n "$pass" ]] && export REDISCLI_AUTH="$pass"
  echo "  → Clearing Redis keys '${prefix}*' in DB ${redis_db}"
  "${cli[@]}" --scan --pattern "${prefix}*" \
    | tr '\n' '\0' \
    | xargs -0 -n 500 "${cli[@]}" unlink > /dev/null \
    || echo "  Warning: Failed to clear Redis keys for '${prefix}'."
  unset REDISCLI_AUTH
}

run_setup() {
  local dir="$1"
  local proj_path="${2:-}"
  local folder_name="${3:-}"
  local ran_any=false

  echo ""
  echo "Running setup in $dir ..."

  # .env: prefer the main project's real .env (has actual credentials),
  # fall back to .env.example
  if [[ ! -f "$dir/.env" ]]; then
    if [[ -n "$proj_path" && -f "$proj_path/.env" ]]; then
      echo "  → Copying .env from main project"
      cp "$proj_path/.env" "$dir/.env"
    elif [[ -f "$dir/.env.example" ]]; then
      echo "  → Copying .env.example to .env"
      cp "$dir/.env.example" "$dir/.env"
    fi
    ran_any=true
  fi

  # Database: clone from main project and update DB_DATABASE
  if [[ -n "$folder_name" ]]; then
    setup_db "$dir" "$folder_name"
    ran_any=true
  fi

  # Redis: own key prefix and DB index so queues/cache don't mix with main
  if [[ -n "$proj_path" && -n "$folder_name" ]]; then
    setup_redis "$dir" "$(basename "$proj_path")" "$folder_name"
  fi

  # PHP / Composer
  if [[ -f "$dir/composer.json" ]]; then
    if command -v composer > /dev/null 2>&1; then
      if [[ -n "$proj_path" && -d "$proj_path/vendor" ]]; then
        copy_dir_from_project "$proj_path/vendor" "$dir/vendor" "vendor"
        echo "  → Running composer dump-autoload"
        composer dump-autoload --working-dir="$dir" 2>&1 \
          | grep -v "does not comply with psr-4" || true
      else
        echo "  → Running composer install"
        composer install --no-interaction --working-dir="$dir" \
          || echo "  Warning: composer install exited with errors."
      fi
      ran_any=true
    else
      echo "  Warning: composer.json found but composer is not installed — skipping."
    fi
  fi

  # Node / JS
  if [[ -f "$dir/package.json" ]]; then
    local node_cmd=""
    if [[ -f "$dir/yarn.lock" ]] && command -v yarn > /dev/null 2>&1; then
      node_cmd="yarn"
    elif [[ -f "$dir/pnpm-lock.yaml" ]] && command -v pnpm > /dev/null 2>&1; then
      node_cmd="pnpm"
    elif command -v npm > /dev/null 2>&1; then
      node_cmd="npm"
    fi

    if [[ -n "$node_cmd" ]]; then
      if [[ -n "$proj_path" && -d "$proj_path/node_modules" ]]; then
        copy_dir_from_project "$proj_path/node_modules" "$dir/node_modules" "node_modules"
        echo "  → Running $node_cmd install (incremental)"
      else
        echo "  → Running $node_cmd install"
      fi
      (cd "$dir" && "$node_cmd" install) \
        || echo "  Warning: $node_cmd install exited with errors."
      ran_any=true
    else
      echo "  Warning: package.json found but no package manager (npm/yarn/pnpm) found — skipping."
    fi
  fi

  if [[ "$ran_any" == false ]]; then
    echo "  (nothing to set up)"
  fi
}

# ─── Status (JSON) ────────────────────────────────────────────────────────────

# json_escape: escape a string for use inside a JSON string literal.
# Escapes \ " newline tab CR; strips other ASCII control characters.
json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s" | LC_ALL=C tr -d '\000-\010\013\014\016-\037'
}

json_str() {
  printf '"%s"' "$(json_escape "$1")"
}

json_str_or_null() {
  if [[ -n "$1" ]]; then json_str "$1"; else printf 'null'; fi
}

json_int_or_null() {
  if [[ "$1" =~ ^[0-9]+$ ]]; then printf '%s' "$((10#$1))"; else printf 'null'; fi
}

# worktree_json: print one worktree as a JSON object
#   $1: main project path
#   $2: worktree path (trailing slash allowed)
worktree_json() {
  local proj_path="$1"
  local wt="${2%/}"
  local env_file="$wt/.env"

  local branch base changes
  branch="$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")"
  base="$(git -C "$proj_path" config --get "branch.${branch}.sproutBase" 2>/dev/null || true)"
  base="${base:-main}"
  changes="$( { git -C "$wt" status --porcelain 2>/dev/null || true; } | wc -l | tr -d ' ')"

  local base_ref="" ahead="" behind="" counts=""
  if git -C "$wt" rev-parse --verify -q "refs/heads/$base" > /dev/null 2>&1; then
    base_ref="refs/heads/$base"
  elif git -C "$wt" rev-parse --verify -q "refs/remotes/origin/$base" > /dev/null 2>&1; then
    base_ref="refs/remotes/origin/$base"
  fi
  if [[ -n "$base_ref" ]]; then
    counts="$(git -C "$wt" rev-list --left-right --count "${base_ref}...HEAD" 2>/dev/null || true)"
    if [[ -n "$counts" ]]; then
      behind="$(echo "$counts" | awk '{print $1}')"
      ahead="$(echo "$counts" | awk '{print $2}')"
    fi
  fi

  local last="null" hash subject when
  hash="$(git -C "$wt" log -1 --format=%h 2>/dev/null || true)"
  if [[ -n "$hash" ]]; then
    subject="$(git -C "$wt" log -1 --format=%s)"
    when="$(git -C "$wt" log -1 --format=%cr)"
    last="{\"hash\":$(json_str "$hash"),\"subject\":$(json_str "$subject"),\"when\":$(json_str "$when")}"
  fi

  local mysql_db="" redis_db="" redis_prefix=""
  if [[ -f "$env_file" ]]; then
    mysql_db="$(parse_env_value DB_DATABASE "$env_file")"
    redis_db="$(parse_env_value REDIS_DB "$env_file")"
    redis_prefix="$(parse_env_value REDIS_PREFIX "$env_file")"
  fi

  printf '{"branch":%s,"folder":%s,"path":%s,"base":%s,"changes":%s,"ahead":%s,"behind":%s,"lastCommit":%s,"mysqlDb":%s,"redisDb":%s,"redisPrefix":%s}' \
    "$(json_str "$branch")" \
    "$(json_str "$(basename "$wt")")" \
    "$(json_str "$wt")" \
    "$(json_str "$base")" \
    "${changes:-0}" \
    "$(json_int_or_null "$ahead")" \
    "$(json_int_or_null "$behind")" \
    "$last" \
    "$(json_str_or_null "$mysql_db")" \
    "$(json_int_or_null "$redis_db")" \
    "$(json_str_or_null "$redis_prefix")"
}

# project_json: print one project (with branches and worktrees) as JSON
#   $1: project name  $2: project path
project_json() {
  local name="$1"
  local path="$2"

  local branches="" b
  while IFS= read -r b; do
    [[ -n "$b" ]] || continue
    branches+="${branches:+,}$(json_str "$b")"
  done < <(git -C "$path" for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null | LC_ALL=C sort)

  local worktrees="" entry
  for entry in "$SPROUT_PROJECTS_ROOT/${name}-worktrees"/*/; do
    [[ -d "${entry}.git" || -f "${entry}.git" ]] || continue
    worktrees+="${worktrees:+,}$(worktree_json "$path" "$entry")"
  done

  printf '{"name":%s,"path":%s,"branches":[%s],"worktrees":[%s]}' \
    "$(json_str "$name")" "$(json_str "$path")" "$branches" "$worktrees"
}

# ─── Commands ─────────────────────────────────────────────────────────────────

cmd_create() {
  local branch=""
  local project_arg=""
  local base_branch="main"
  local skip_setup=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project)
        [[ -n "${2:-}" ]] || die "Missing value for --project."
        project_arg="$2"
        shift 2
        ;;
      --from)
        [[ -n "${2:-}" ]] || die "Missing value for --from."
        base_branch="$2"
        shift 2
        ;;
      --no-setup)
        skip_setup=true
        shift
        ;;
      -*)
        die "Unknown option: $1. Run '$SCRIPT_NAME help create' for usage."
        ;;
      *)
        [[ -z "$branch" ]] || die "Unexpected argument: $1. Run '$SCRIPT_NAME help create' for usage."
        branch="$1"
        shift
        ;;
    esac
  done

  [[ -n "$branch" ]] \
    || die "Missing required argument: <branch-name>. Run '$SCRIPT_NAME help create' for usage."

  resolve_project "$project_arg"
  local proj_name="$REPLY_PROJECT_NAME"
  local proj_path="$REPLY_PROJECT_PATH"

  # Verify base branch exists
  git -C "$proj_path" rev-parse --verify "refs/heads/$base_branch" > /dev/null 2>&1 \
    || git -C "$proj_path" rev-parse --verify "refs/remotes/origin/$base_branch" > /dev/null 2>&1 \
    || die "Base branch '$base_branch' does not exist in project '$proj_name'."

  # Ensure branch does not already exist (local or remote)
  if git -C "$proj_path" rev-parse --verify "refs/heads/$branch" > /dev/null 2>&1 \
    || git -C "$proj_path" rev-parse --verify "refs/remotes/origin/$branch" > /dev/null 2>&1; then
    die "Branch '$branch' already exists in '$proj_name'. sprout-parallel only creates new branches."
  fi

  local folder_name
  folder_name="$(safe_name "$branch")"
  local worktrees_dir="$SPROUT_PROJECTS_ROOT/${proj_name}-worktrees"
  local worktree_path="$worktrees_dir/$folder_name"

  mkdir -p "$worktrees_dir"

  git -C "$proj_path" worktree add -b "$branch" "$worktree_path" "$base_branch" \
    || die2 "git worktree add failed. Ensure git 2.17+ is installed."

  # Remember the base so `status` can report ahead/behind against it
  git -C "$proj_path" config "branch.${branch}.sproutBase" "$base_branch"

  echo "Created worktree for branch '$folder_name'"
  echo "  Project : $proj_name"
  echo "  Branch  : $branch"
  echo "  Path    : $worktree_path"
  echo "  Base    : $base_branch"

  if [[ "$skip_setup" == false ]]; then
    run_setup "$worktree_path" "$proj_path" "$folder_name"
  fi
}

cmd_delete() {
  local branch=""
  local project_arg=""
  local force=false
  local keep_db=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project)
        [[ -n "${2:-}" ]] || die "Missing value for --project."
        project_arg="$2"
        shift 2
        ;;
      --force)
        force=true
        shift
        ;;
      --keep-db)
        keep_db=true
        shift
        ;;
      -*)
        die "Unknown option: $1. Run '$SCRIPT_NAME help delete' for usage."
        ;;
      *)
        [[ -z "$branch" ]] || die "Unexpected argument: $1. Run '$SCRIPT_NAME help delete' for usage."
        branch="$1"
        shift
        ;;
    esac
  done

  [[ -n "$branch" ]] \
    || die "Missing required argument: <branch-name>. Run '$SCRIPT_NAME help delete' for usage."

  resolve_project "$project_arg"
  local proj_name="$REPLY_PROJECT_NAME"
  local proj_path="$REPLY_PROJECT_PATH"

  local folder_name
  folder_name="$(safe_name "$branch")"
  local worktree_path="$SPROUT_PROJECTS_ROOT/${proj_name}-worktrees/$folder_name"

  [[ -d "$worktree_path" ]] \
    || die "No worktree found for branch '$branch' in project '$proj_name'."

  # Check for uncommitted changes
  local dirty
  dirty="$(git -C "$worktree_path" status --porcelain 2>/dev/null || true)"
  if [[ -n "$dirty" && "$force" == false ]]; then
    die "Worktree '$branch' has uncommitted changes. Use --force to delete anyway."
  fi

  # Drop the worktree database and Redis keys before the folder is removed
  if [[ "$keep_db" == false ]]; then
    drop_worktree_db "$worktree_path/.env"
    clear_worktree_redis "$worktree_path/.env"
  fi

  if [[ "$force" == true ]]; then
    git -C "$proj_path" worktree remove --force "$worktree_path" \
      || die2 "git worktree remove failed."
  else
    git -C "$proj_path" worktree remove "$worktree_path" \
      || die2 "git worktree remove failed."
  fi

  git -C "$proj_path" worktree prune

  echo "Deleted worktree '$folder_name'"
  echo "  Project : $proj_name"
  echo "  Path    : $worktree_path"
}

cmd_clear() {
  local project_arg=""
  local force=false
  local keep_db=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project)
        [[ -n "${2:-}" ]] || die "Missing value for --project."
        project_arg="$2"
        shift 2
        ;;
      --force)
        force=true
        shift
        ;;
      --keep-db)
        keep_db=true
        shift
        ;;
      -*)
        die "Unknown option: $1. Run '$SCRIPT_NAME help clear' for usage."
        ;;
      *)
        die "Unexpected argument: $1. Run '$SCRIPT_NAME help clear' for usage."
        ;;
    esac
  done

  resolve_project "$project_arg"
  local proj_name="$REPLY_PROJECT_NAME"

  local flags=""
  [[ "$force" == true ]] && flags+=" --force"
  [[ "$keep_db" == true ]] && flags+=" --keep-db"

  local cleared=0 skipped=0 failed=0 found=false entry folder dirty
  for entry in "$SPROUT_PROJECTS_ROOT/${proj_name}-worktrees"/*/; do
    [[ -d "${entry}.git" || -f "${entry}.git" ]] || continue
    found=true
    folder="$(basename "$entry")"

    if [[ "$force" == false ]]; then
      dirty="$(git -C "$entry" status --porcelain 2>/dev/null || true)"
      if [[ -n "$dirty" ]]; then
        echo "Skipped '$folder' (uncommitted changes — use --force to delete it)"
        skipped=$((skipped + 1))
        continue
      fi
    fi

    # Subshell: a failing delete exits only its own shell, so the rest still run
    # shellcheck disable=SC2086
    if ( cmd_delete "$folder" --project "$proj_name" $flags ); then
      cleared=$((cleared + 1))
    else
      echo "Failed to delete '$folder'"
      failed=$((failed + 1))
    fi
  done

  if [[ "$found" == false ]]; then
    echo "No worktrees to clear in project '$proj_name'."
    return 0
  fi

  echo ""
  echo "cleared $cleared · skipped $skipped · failed $failed"
  [[ "$failed" -eq 0 ]] || die "Failed to delete $failed worktree(s) in '$proj_name'."
}

cmd_list() {
  local project_arg=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project)
        [[ -n "${2:-}" ]] || die "Missing value for --project."
        project_arg="$2"
        shift 2
        ;;
      -*)
        die "Unknown option: $1. Run '$SCRIPT_NAME help list' for usage."
        ;;
      *)
        die "Unexpected argument: $1. Run '$SCRIPT_NAME help list' for usage."
        ;;
    esac
  done

  resolve_project "$project_arg"
  local proj_name="$REPLY_PROJECT_NAME"

  local worktrees_dir="$SPROUT_PROJECTS_ROOT/${proj_name}-worktrees"

  if [[ ! -d "$worktrees_dir" ]]; then
    echo "No parallel worktrees found for project: $proj_name"
    return 0
  fi

  local found=false
  local lines=()

  for entry in "$worktrees_dir"/*/; do
    [[ -d "$entry" ]] || continue
    [[ -d "${entry}.git" || -f "${entry}.git" ]] || continue

    local wt_branch
    wt_branch="$(git -C "$entry" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")"

    local wt_porcelain
    wt_porcelain="$(git -C "$entry" status --porcelain 2>/dev/null || true)"
    local wt_status="clean"
    [[ -n "$wt_porcelain" ]] && wt_status="dirty"

    lines+=("  ${entry%/}  [$wt_branch]  $wt_status")
    found=true
  done

  if [[ "$found" == false ]]; then
    echo "No parallel worktrees found for project: $proj_name"
    return 0
  fi

  echo "Worktrees for project: $proj_name"
  printf '%s\n' "${lines[@]}"
}

cmd_status() {
  local json=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)
        json=true
        shift
        ;;
      *)
        die "Unknown option: $1. Run '$SCRIPT_NAME help status' for usage."
        ;;
    esac
  done

  [[ "$json" == true ]] \
    || die "status currently requires --json. Run '$SCRIPT_NAME help status' for usage."
  [[ -d "$SPROUT_PROJECTS_ROOT" ]] \
    || die "Projects root '$SPROUT_PROJECTS_ROOT' does not exist."

  local with="" without="" dir name project
  for dir in "$SPROUT_PROJECTS_ROOT"/*/; do
    dir="${dir%/}"
    name="$(basename "$dir")"
    [[ "$name" == *-worktrees ]] && continue
    [[ -d "$dir/.git" || -f "$dir/.git" ]] || continue

    project="$(project_json "$name" "$dir")"
    if [[ "$project" == *'"worktrees":[]}' ]]; then
      without+="${without:+,}$project"
    else
      with+="${with:+,}$project"
    fi
  done

  local all="$with"
  if [[ -n "$without" ]]; then
    all+="${all:+,}$without"
  fi
  printf '{"projects":[%s]}\n' "$all"
}

cmd_help() {
  local topic="${1:-}"

  case "$topic" in
    create)
      cat <<EOF
COMMAND: $SCRIPT_NAME create <branch-name> [options]

  Creates a new git branch and a new worktree for it.

ARGUMENTS:
  <branch-name>        Required. Name of the new branch to create.
                       Must not already exist in the repository.

OPTIONS:
  --project <name>     Target project under \$SPROUT_PROJECTS_ROOT.
                       Auto-detected when inside a project directory.
  --from <base>        Base branch for the new branch. Default: main
  --no-setup           Skip automatic setup (composer, npm, db clone, etc.)

SETUP (auto-detected, runs after worktree creation):
  .env                 Copied from main project's .env (real credentials)
  DB_DATABASE          New database cloned from main and .env updated
  Redis                Own REDIS_PREFIX / CACHE_PREFIX / HORIZON_PREFIX and a
                       free REDIS_DB (= REDIS_CACHE_DB) index, so queues and
                       cache don't mix with the main project or other worktrees
  composer.json        vendor/ seeded from main project + composer dump-autoload
  package.json         node_modules/ seeded from main project + npm/yarn/pnpm install

BASE TRACKING:
  The base branch is stored in git config (branch.<name>.sproutBase) so
  'status --json' can report commits ahead/behind it.

EXAMPLES:
  $SCRIPT_NAME create feature/my-thing
  $SCRIPT_NAME create hotfix/urgent --from production
  $SCRIPT_NAME create feature/my-thing --project scooda
  $SCRIPT_NAME create feature/my-thing --no-setup

WORKTREE PATH:
  \$SPROUT_PROJECTS_ROOT/<project>-worktrees/<branch-folder>/

EXIT CODES:
  0  Success
  1  User error (branch exists, project not found, missing args)
  2  git command failed
EOF
      ;;
    clear)
      cat <<EOF
COMMAND: $SCRIPT_NAME clear [options]

  Deletes every worktree of a project, one by one, as 'delete' would.
  Worktrees with uncommitted changes are skipped unless --force is given.
  A failing delete does not stop the others. Branches are kept.

OPTIONS:
  --project <name>     Target project. Auto-detected if inside a project.
  --force              Also delete worktrees with uncommitted changes.
  --keep-db            Skip dropping databases and clearing Redis keys.

EXAMPLES:
  $SCRIPT_NAME clear --project scooda
  $SCRIPT_NAME clear --project scooda --force --keep-db

EXIT CODES:
  0  Every worktree was deleted or skipped
  1  At least one delete failed, or project not found
EOF
      ;;
    delete)
      cat <<EOF
COMMAND: $SCRIPT_NAME delete <branch-name> [options]

  Removes a worktree folder, its git registration, its cloned database,
  and its Redis keys.

ARGUMENTS:
  <branch-name>        Required. Branch name whose worktree to delete.

OPTIONS:
  --project <name>     Target project. Auto-detected if inside a project.
  --force              Required when the worktree has uncommitted changes.
  --keep-db            Skip dropping the worktree's cloned database and
                       clearing its Redis keys.

EXAMPLES:
  $SCRIPT_NAME delete feature/my-thing
  $SCRIPT_NAME delete feature/my-thing --force
  $SCRIPT_NAME delete feature/my-thing --keep-db
  $SCRIPT_NAME delete feature/my-thing --project scooda

EXIT CODES:
  0  Success
  1  User error (not found, dirty without --force, project not found)
  2  git command failed
EOF
      ;;
    list)
      cat <<EOF
COMMAND: $SCRIPT_NAME list [options]

  Lists all parallel worktrees for a project.

OPTIONS:
  --project <name>     Target project. Auto-detected if inside a project.

EXAMPLES:
  $SCRIPT_NAME list
  $SCRIPT_NAME list --project scooda

OUTPUT (when worktrees exist):
  Worktrees for project: scooda
    /Users/mehdi/projects/scooda-worktrees/feature-my-thing  [feature/my-thing]  clean
    /Users/mehdi/projects/scooda-worktrees/fix-TICKET-123    [fix/TICKET-123]    dirty

EXIT CODES:
  0  Always (even when no worktrees found)
  1  Project not found
EOF
      ;;
    status)
      cat <<EOF
COMMAND: $SCRIPT_NAME status --json

  Prints every project under \$SPROUT_PROJECTS_ROOT and its worktrees as one
  line of JSON. Used by the Sprout menu bar app.

  Per worktree: branch, folder, path, base, changes, ahead, behind,
  lastCommit {hash, subject, when}, mysqlDb, redisDb, redisPrefix.
  Unknown values are null. Projects with worktrees are listed first.

EXIT CODES:
  0  Success
  1  --json missing, or projects root not found
EOF
      ;;
    ""|help)
      cat <<EOF
$SCRIPT_NAME — git worktree manager

USAGE:
  $SCRIPT_NAME <command> [options]

COMMANDS:
  create <branch>   Create a new branch and worktree
  delete <branch>   Remove a worktree, its git registration, database, and Redis keys
  clear             Remove every worktree of a project
  list              List all worktrees for a project
  status --json     Print all projects and worktrees as JSON
  help [command]    Show help for a specific command

GLOBAL OPTIONS:
  --help, -h        Show this help message

ENVIRONMENT:
  SPROUT_PROJECTS_ROOT   Root directory containing your git projects.
                         Default: /Users/mehdi/projects

WORKTREE LOCATION:
  Worktrees are created at:
  \$SPROUT_PROJECTS_ROOT/<project>-worktrees/<branch-folder>/

  Example:
    Project:  /Users/mehdi/projects/scooda
    Branch:   feature/my-thing
    Worktree: /Users/mehdi/projects/scooda-worktrees/feature-my-thing

EXAMPLES:
  $SCRIPT_NAME create feature/my-thing
  $SCRIPT_NAME create feature/my-thing --from develop --project scooda
  $SCRIPT_NAME delete feature/my-thing
  $SCRIPT_NAME delete feature/my-thing --force
  $SCRIPT_NAME list
  $SCRIPT_NAME list --project scooda

For command-specific help:
  $SCRIPT_NAME help create
  $SCRIPT_NAME help delete
  $SCRIPT_NAME help list
  $SCRIPT_NAME help status
  $SCRIPT_NAME help clear
EOF
      ;;
    *)
      die "Unknown help topic: '$topic'. Available: create, delete, clear, list, status"
      ;;
  esac
}

# ─── Entrypoint ───────────────────────────────────────────────────────────────

main() {
  local cmd="${1:-help}"
  shift 2>/dev/null || true

  case "$cmd" in
    create)    cmd_create "$@" ;;
    delete)    cmd_delete "$@" ;;
    clear)     cmd_clear  "$@" ;;
    list)      cmd_list   "$@" ;;
    status)    cmd_status "$@" ;;
    help)      cmd_help   "$@" ;;
    --help|-h) cmd_help ;;
    *)
      echo "Error: Unknown command: '$cmd'. Run '$SCRIPT_NAME help' for usage." >&2
      exit 1
      ;;
  esac
}

main "$@"
